      "css": ".ds-input{min-height:40px;padding:7px 10px;border:1px solid var(--base,#c4c2ba);border-radius:2px;background:var(--fundo,#fff);color:var(--tinta,#151514);font:15px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}.ds-input::placeholder{color:var(--tinta-3,#74726b)}.ds-input:hover{border-color:var(--tinta-3,#74726b)}.ds-input:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:0;border-color:var(--tinta,#151514)}"
