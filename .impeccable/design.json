  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled main action; one per context.",
      "html": "<button class=\"ds-btn-primary\">Salvar</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:7px 14px;border:1px solid var(--tinta,#151514);border-radius:2px;background:var(--tinta,#151514);color:var(--fundo,#fff);font:550 15px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer}.ds-btn-primary:hover{background:var(--tinta-2,#53524d);border-color:var(--tinta-2,#53524d)}.ds-btn-primary:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default paper button with a strong hairline.",
      "html": "<button class=\"ds-btn\">Exportar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:7px 14px;border:1px solid var(--base,#c4c2ba);border-radius:2px;background:var(--fundo,#fff);color:var(--tinta,#151514);font:550 15px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer}.ds-btn:hover{background:var(--jornal,#f0efeb);border-color:var(--tinta-3,#74726b)}.ds-btn:active{background:var(--jornal-2,#e6e5e0)}.ds-btn:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action: red text, red border on hover.",
