      "refersTo": "tab",
      "description": "Desktop top-bar tabs; selected gets ink weight and a 3px ink underline.",
      "html": "<nav class=\"ds-abas\"><button class=\"ds-aba\" aria-selected=\"true\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"16\" rx=\"1\"/><path d=\"M3.5 9.5h17M8 2.5v4M16 2.5v4M8 13.5h2M14 13.5h2M8 17h2\"/></svg>Resumo</button><button class=\"ds-aba\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\"><path d=\"M9 6.5h11M9 12h11M9 17.5h11M4 6.5h1.5M4 12h1.5M4 17.5h1.5\"/></svg>Transações</button></nav>",
      "css": ".ds-abas{display:flex;gap:2px;border-bottom:1px solid var(--linha,#e2e1dc)}.ds-aba{position:relative;display:flex;align-items:center;gap:8px;height:56px;padding:0 12px;border:0;background:none;color:var(--tinta-2,#53524d);font:500 15px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer}.ds-aba:hover{color:var(--tinta,#151514)}.ds-aba[aria-selected=\"true\"]{color:var(--tinta,#151514);font-weight:650}.ds-aba[aria-selected=\"true\"]::after{content:\"\";position:absolute;left:12px;right:12px;bottom:-1px;height:3px;background:var(--tinta,#151514)}.ds-aba:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}.ds-ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Person Chip",
      "kind": "chip",
      "refersTo": null,
      "description": "Choice between the two people; marker plus name, ink inset when checked.",
      "html": "<div class=\"ds-escolha\"><label><input type=\"radio\" name=\"p\" checked><span class=\"ds-b ds-p1\"></span>Ana</label><label><input type=\"radio\" name=\"p\"><span class=\"ds-b ds-p2\"></span>Beto</label></div>",
      "css": ".ds-escolha{display:flex;gap:8px;font:15px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;color:var(--tinta,#151514)}.ds-escolha label{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:9px 16px;border:1px solid var(--base,#c4c2ba);border-radius:2px;cursor:pointer}.ds-escolha label:hover{border-color:var(--tinta-3,#74726b)}.ds-escolha label:has(input:checked){border-color:var(--tinta,#151514);box-shadow:inset 0 0 0 1px var(--tinta,#151514);background:var(--jornal,#f0efeb);font-weight:650}.ds-escolha label:focus-within{outline:2px solid var(--tinta,#151514);outline-offset:2px}.ds-escolha input{accent-color:var(--tinta,#151514);width:16px;height:16px}.ds-b{width:10px;height:10px;border-radius:1px}.ds-p1{background:var(--p1,#2a78d6)}.ds-p2{background:var(--p2,#eb6834)}"
    },
    {
      "name": "Month Sheet",
      "kind": "custom",
      "refersTo": "day-cell",
      "description": "Signature: ink weekday band over hairline day cells with spend, who-paid bar, over-pace red, today frame, holiday name.",
      "html": "<div class=\"ds-folha\"><div class=\"ds-sem\"><div>D</div><div>S</div><div>T</div><div>Q</div><div>Q</div><div>S</div><div>S</div></div><div class=\"ds-dias\"><button class=\"ds-dia ds-acima\"><span class=\"ds-n\">4</span><span class=\"ds-v\">685</span><span class=\"ds-barra\"><span style=\"flex:1;background:var(--p1,#2a78d6)\"></span><span style=\"flex:5;background:var(--p2,#eb6834)\"></span></span></button><button class=\"ds-dia\"><span class=\"ds-n\">5</span><span class=\"ds-v\">120</span><span class=\"ds-barra\"><span style=\"flex:1;background:var(--p1,#2a78d6)\"></span></span></button><button class=\"ds-dia ds-sel\"><span class=\"ds-n\">8</span><span class=\"ds-v\">459</span></button><button class=\"ds-dia ds-hoje\"><span class=\"ds-n\">11</span></button><button class=\"ds-dia ds-futuro\"><span class=\"ds-n\">12</span><span class=\"ds-f\">Aparecida</span></button><button class=\"ds-dia ds-futuro\"><span class=\"ds-n\">13</span></button><button class=\"ds-dia ds-futuro\"><span class=\"ds-n\">14</span></button></div></div>",
      "css": ".ds-folha{max-width:560px}.ds-sem,.ds-dias{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.ds-sem{background:var(--tinta,#151514)}.ds-sem div{padding:6px 0 5px;text-align:center;font:800 15px \"Folha\", \"Arial Narrow\", \"Roboto Condensed\", sans-serif;letter-spacing:.04em;color:var(--fundo,#fff)}.ds-dias{border-left:1px solid var(--linha,#e2e1dc)}.ds-dia{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-height:74px;padding:7px 7px 11px;border:0;border-right:1px solid var(--linha,#e2e1dc);border-bottom:1px solid var(--linha,#e2e1dc);background:none;color:var(--tinta,#151514);text-align:left;cursor:pointer;transition:background-color .15s cubic-bezier(.16,1,.3,1)}.ds-dia:hover{background:var(--jornal,#f0efeb)}.ds-dia:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}.ds-n{font:800 28px/.9 \"Folha\", \"Arial Narrow\", \"Roboto Condensed\", sans-serif}.ds-v{margin-top:auto;padding-top:4px;font:12px/1.2 system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--tinta-2,#53524d)}.ds-barra{position:absolute;left:7px;right:7px;bottom:5px;height:3px;display:flex;gap:1px}.ds-acima .ds-n,.ds-acima .ds-v{color:var(--vermelho,#c4122f)}.ds-hoje{box-shadow:inset 0 0 0 2px var(--tinta,#151514)}.ds-sel{box-shadow:inset 0 4px 0 var(--tinta,#151514);background:var(--jornal-2,#e6e5e0)}.ds-futuro{cursor:default}.ds-futuro:hover{background:none}.ds-futuro .ds-n{color:var(--tinta-3,#74726b);font-weight:600}.ds-f{margin-top:3px;font:600 13px/1 \"Folha\", \"Arial Narrow\", \"Roboto Condensed\", sans-serif;color:var(--tinta,#151514)}"
    },
    {
      "name": "Mini-folha",
      "kind": "custom",
      "refersTo": "mini-folha",
      "description": "Signature tear-off date tile for closing/due dates and day-group headers.",
      "html": "<div class=\"ds-mf\"><div class=\"ds-mf-cab\">Vence</div><div class=\"ds-mf-n\">13</div><div class=\"ds-mf-m\">nov</div></div>",
      "css": ".ds-mf{width:62px;border:1px solid var(--tinta,#151514);text-align:center;background:var(--fundo,#fff);color:var(--tinta,#151514)}.ds-mf-cab{background:var(--tinta,#151514);color:var(--fundo,#fff);font:700 11px system-ui,sans-serif;letter-spacing:.03em;text-transform:uppercase;padding:2px 0}.ds-mf-n{font:800 30px/1 \"Folha\", \"Arial Narrow\", \"Roboto Condensed\", sans-serif;padding-top:4px}.ds-mf-m{font:11px system-ui,sans-serif;color:var(--tinta-2,#53524d);padding-bottom:4px}"
    },
    {
      "name": "Budget Meter",
      "kind": "custom",
      "refersTo": null,
      "description": "Ink fill to today's pace, red past it, haloed pace tick layered above Clo, who stands where spending reached (5-95%).",
      "html": "<div class=\"ds-med\"><span class=\"ds-poleiro\" style=\"left:30%\"><svg viewBox=\"0 0 64 72\" aria-hidden=\"true\"><path d=\"M26 62l-3.5 9h19L38 62z\" fill=\"#4a4b50\"/> <ellipse cx=\"32\" cy=\"51\" rx=\"17.5\" ry=\"17\" fill=\"#6b6c6f\"/> <ellipse cx=\"32\" cy=\"56\" rx=\"9.5\" ry=\"11\" fill=\"#85868a\"/> <ellipse cx=\"16.5\" cy=\"52.5\" rx=\"6.2\" ry=\"12.5\" transform=\"rotate(14 16.5 52.5)\" fill=\"#4a4b50\"/> <ellipse cx=\"47.5\" cy=\"52.5\" rx=\"6.2\" ry=\"12.5\" transform=\"rotate(-14 47.5 52.5)\" fill=\"#4a4b50\"/> <ellipse cx=\"15.6\" cy=\"47\" rx=\"3.4\" ry=\"6\" transform=\"rotate(14 15.6 47)\" fill=\"#eef2f1\"/> <ellipse cx=\"48.4\" cy=\"47\" rx=\"3.4\" ry=\"6\" transform=\"rotate(-14 48.4 47)\" fill=\"#eef2f1\"/> <g transform=\"translate(13 4) scale(.59)\"><path d=\"M30 11.5c1.2-3.6 3.2-6.6 6.2-8.6.9-.6 2.1-.1 2.2 1 .1 1.6-.4 3.2-1.2 4.6 1.6-1.6 3.6-2.6 5.8-3 1.1-.2 1.9.9 1.4 1.9-.9 1.7-2.2 3.1-3.8 4.1 1.5-.5 3.1-.5 4.6 0 1 .3 1.2 1.6.4 2.3-2.4 2.1-5.6 3.2-8.8 3z\" fill=\"#f4d84f\"/> <circle cx=\"32\" cy=\"37\" r=\"26\" fill=\"#f4d84f\"/> <circle cx=\"21\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"43\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"14.6\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <circle cx=\"49.4\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <path d=\"M27.8 36.2h8.4c1.2 0 1.9 1.3 1.3 2.3l-4.2 7c-.6 1-2 1-2.6 0l-4.2-7c-.6-1 .1-2.3 1.3-2.3z\" fill=\"#f2bf72\"/></g> <path d=\"M27.5 67.6v3M36.5 67.6v3\" stroke=\"#f2bf72\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg></span><div class=\"ds-med-cheio\" style=\"width:35%\"></div><div class=\"ds-med-ritmo\" style=\"left:40%\"></div><div class=\"ds-med-fim\" style=\"left:100%\"></div></div>",
      "css": ".ds-med{position:relative;height:12px;background:var(--jornal-2,#e6e5e0);margin:72px 0 12px;max-width:560px}.ds-med-cheio{position:absolute;left:0;top:0;bottom:0;background:var(--tinta,#151514)}.ds-passou{background:var(--vermelho,#c4122f)}.ds-med-ritmo{position:absolute;z-index:2;top:-6px;bottom:-6px;width:2px;margin-left:-1px;background:var(--tinta,#151514);box-shadow:0 0 0 2px var(--fundo,#fff)}.ds-med-fim{position:absolute;top:-6px;bottom:-6px;width:2px;margin-left:-1px;background:var(--tinta-3,#74726b)}.ds-poleiro{position:absolute;z-index:1;bottom:calc(100% - 1px);width:52px;height:58px;margin-left:-26px}.ds-poleiro svg{width:100%;height:100%;display:block;overflow:visible}"
    },
    {
      "name": "Theme Toggle",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "Top-bar sun/moon square that flips this device between light and dark; 44px on phone.",
      "html": "<button class=\"ds-tema\" aria-label=\"Mudar para o modo escuro\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\"><path d=\"M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1z\"/></svg></button>",
      "css": ".ds-tema{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--linha,#e2e1dc);border-radius:2px;background:var(--fundo,#fff);color:var(--tinta-2,#53524d);cursor:pointer}.ds-tema:hover{border-color:var(--base,#c4c2ba);color:var(--tinta,#151514)}.ds-tema:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}.ds-ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Appearance Options",
      "kind": "chip",
      "refersTo": "appearance-option",
      "description": "Configurar → Aparência radio row; same chip as the person choice.",
      "html": "<div class=\"ds-aparencia\" role=\"radiogroup\" aria-label=\"Aparência\"><label><input type=\"radio\" name=\"t\" checked>Automático</label><label><input type=\"radio\" name=\"t\">Claro</label><label><input type=\"radio\" name=\"t\">Escuro</label></div>",
      "css": ".ds-aparencia{display:flex;flex-wrap:wrap;gap:8px;font:15px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;color:var(--tinta,#151514)}.ds-aparencia label{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:9px 16px;border:1px solid var(--base,#c4c2ba);border-radius:2px;cursor:pointer}.ds-aparencia label:hover{border-color:var(--tinta-3,#74726b)}.ds-aparencia label:has(input:checked){border-color:var(--tinta,#151514);box-shadow:inset 0 0 0 1px var(--tinta,#151514);background:var(--jornal,#f0efeb);font-weight:650}.ds-aparencia label:focus-within{outline:2px solid var(--tinta,#151514);outline-offset:2px}.ds-aparencia input{accent-color:var(--tinta,#151514);width:16px;height:16px}"
    },
    {
      "name": "Clo Mark",
      "kind": "custom",
      "refersTo": "clo-mark",
      "description": "Brand mark: Clo's head at 32px beside the Folha 800 26px wordmark.",
      "html": "<div class=\"ds-marca\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"M30 11.5c1.2-3.6 3.2-6.6 6.2-8.6.9-.6 2.1-.1 2.2 1 .1 1.6-.4 3.2-1.2 4.6 1.6-1.6 3.6-2.6 5.8-3 1.1-.2 1.9.9 1.4 1.9-.9 1.7-2.2 3.1-3.8 4.1 1.5-.5 3.1-.5 4.6 0 1 .3 1.2 1.6.4 2.3-2.4 2.1-5.6 3.2-8.8 3z\" fill=\"#f4d84f\"/> <circle cx=\"32\" cy=\"37\" r=\"26\" fill=\"#f4d84f\"/> <circle cx=\"21\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"43\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"14.6\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <circle cx=\"49.4\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <path d=\"M27.8 36.2h8.4c1.2 0 1.9 1.3 1.3 2.3l-4.2 7c-.6 1-2 1-2.6 0l-4.2-7c-.6-1 .1-2.3 1.3-2.3z\" fill=\"#f2bf72\"/></svg><span>Clo</span></div>",
      "css": ".ds-marca{display:flex;align-items:center;gap:10px;color:var(--tinta,#151514)}.ds-marca svg{width:32px;height:32px;flex:none}.ds-marca span{font:800 26px/1 \"Folha\",\"Arial Narrow\",\"Roboto Condensed\",sans-serif;letter-spacing:.01em}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Transient ink strip led by Clo's head; the only lifted element besides the tooltip.",
      "html": "<div class=\"ds-brinde\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><path d=\"M30 11.5c1.2-3.6 3.2-6.6 6.2-8.6.9-.6 2.1-.1 2.2 1 .1 1.6-.4 3.2-1.2 4.6 1.6-1.6 3.6-2.6 5.8-3 1.1-.2 1.9.9 1.4 1.9-.9 1.7-2.2 3.1-3.8 4.1 1.5-.5 3.1-.5 4.6 0 1 .3 1.2 1.6.4 2.3-2.4 2.1-5.6 3.2-8.8 3z\" fill=\"#f4d84f\"/> <circle cx=\"32\" cy=\"37\" r=\"26\" fill=\"#f4d84f\"/> <circle cx=\"21\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"43\" cy=\"33\" r=\"3.7\" fill=\"#1b1b1d\"/> <circle cx=\"14.6\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <circle cx=\"49.4\" cy=\"41.5\" r=\"5.4\" fill=\"#e8873a\"/> <path d=\"M27.8 36.2h8.4c1.2 0 1.9 1.3 1.3 2.3l-4.2 7c-.6 1-2 1-2.6 0l-4.2-7c-.6-1 .1-2.3 1.3-2.3z\" fill=\"#f2bf72\"/></svg><span>Categoria salva.</span></div>",
      "css": ".ds-brinde{display:inline-flex;align-items:center;gap:10px;padding:11px 14px;background:var(--tinta,#151514);color:var(--fundo,#fff);font:14px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;box-shadow:var(--sombra-solta,0 6px 24px rgba(21,21,20,.16))}.ds-brinde svg{width:22px;height:22px;flex:none}"
    }
  ],
  "narrative": {
    "northStar": "A Folhinha de Parede",
    "overview": "The app is the Brazilian tear-off wall calendar hung by the kitchen door: a sheet of cold white paper, black ink, and the red the calendar reserves for days that matter. The month is the sheet. Its name is printed huge in an extra-condensed face, the weekdays run across in a solid ink band, and each day carries the money that left on it. You read the month at a glance, then tap a day to see what went out.\n\nDensity is that of a printed calendar or a newspaper page: many numbers, tightly set, held apart by 1px rules rather than boxes. A second layer of grey \"jornal\" newsprint carries hover, filters, logs and quiet surfaces. Nothing floats at rest; corners are square; the only heavy marks are ink rules under section heads. The system explicitly refuses the dashboard of rounded, shadowed cards with loose numbers in equal blocks.\n\nTwo colors belong to people, not to the system: Person 1 blue and Person 2 orange. They appear only as small square markers, bar segments, and stacked columns, always with the person's name beside them.\n\nThe app is named Clo, after its mascot: Clo, the couple's cockatiel, drawn flat and front-facing in the colors of the real bird. Her head is the brand mark. Whole, she appears only at a few fixed moments and keeps her colors inside her drawing; the folhinha world around her does not change.",
    "keyCharacteristics": [
      "Cold white paper, black ink, newsprint grey second layer; light and dark themes with the same roles, automatic or chosen per device.",
      "Extra-condensed \"Folha\" numerals for the month, headline values, section titles and day numbers; system sans with tabular numerals for everything else.",
      "Square corners (2px max), 1px hairline rules, 2-3px ink rules for heads, no card shadows.",
      "Red is the limit color, never decoration.",
      "Single-stroke SVG icons at 1.75 stroke.",
      "Clo, a flat filled cockatiel illustration, is the brand mark and the only full-color drawing; her colors never enter the UI."
    ],
    "rules": [
      {
        "name": "The Red Means Limit Rule",
        "body": "Red appears only where something passed a limit or failed: over pace, over budget, overdue, sync or import error, destructive action. Never as an accent, a heading, a link, or a brand mark. A screen within budget shows no red at all.",
        "section": "colors"
      },
      {
        "name": "The Name Beside the Color Rule",
        "body": "Person blue and orange never stand alone: every marker, bar, or column has the person's name in a legend or label beside it.",
        "section": "colors"
      },
      {
        "name": "The Ink, Not Hue Rule",
        "body": "Emphasis and selection are made in ink (weight, an ink rule, an inset ink frame), not with a new color.",
        "section": "colors"
      },
      {
        "name": "The Feathers Stay in the Drawing Rule",
        "body": "Clo's yellow, orange and greys exist only inside her illustration. No text, fill, border, chart or state ever borrows them; the cockatiel yellow is not a brand hue.",
        "section": "colors"
      },
      {
        "name": "The Folha for Figures Rule",
        "body": "The condensed face is for the month, headline amounts, block titles, day numbers, the mini-folha date and the \"Clo\" wordmark. Body copy, buttons and form labels stay in the system face.",
        "section": "typography"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Every currency amount outside the Folha headlines uses tabular numerals and does not wrap.",
        "section": "typography"
      },
      {
        "name": "The Paper Doesn't Float Rule",
        "body": "Content surfaces sit on the page with no shadow. A shadow means \"this is transient and on top,\" and nothing else gets it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** open every tab with the sheet head: Folha 800 uppercase title, closed by a 3px ink rule.",
      "**Do** separate rows and cells with 1px hairlines and mark heads and totals with 2px ink rules.",
      "**Do** reserve red for over-limit, overdue, error and destructive states, and pair it with the alert icon or explicit words (\"acima\", \"venceu\").",
      "**Do** set every money amount in tabular numerals; reserve Folha for headline figures and day numbers.",
      "**Do** put the person's name beside every blue or orange mark.",
      "**Do** use jornal for hover and quiet surfaces, and inset ink for selection.",
      "**Do** keep corners at 0 for surfaces and 2px for controls.",
      "**Do** use Clo's head as the brand mark (top bar, favicon, home-screen icon, toast) and the whole Clo only on the budget meter and in empty states.",
      "**Do** keep light and dark as the same roles, applied before first paint from the device's saved choice, with `theme-color` following the visible theme."
    ],
    "donts": [
      "**Don't** build rounded, shadowed dashboard cards or equal blocks of loose numbers.",
      "**Don't** use red as an accent, heading color, link color or decoration.",
      "**Don't** add shadows to anything that sits on the page; the soft lift is for tooltip and toast only.",
      "**Don't** introduce a brand hue; emphasis is ink.",
      "**Don't** let Clo's colors leave her drawing, and don't add new Clo poses or placements beyond the three symbols and the placements above.",
      "**Don't** make Clo the only carrier of a state; the numbers and words lead, she follows.",
      "**Don't** use cream or warm paper; the page is cold white.",
      "**Don't** use emoji or icon fonts; icons are the single-stroke SVG sprite."
    ]
  }
}
