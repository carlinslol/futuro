      "css": ".ds-btn-perigo{display:inline-flex;align-items:center;min-height:40px;padding:7px 14px;border:1px solid var(--base,#c4c2ba);border-radius:2px;background:var(--fundo,#fff);color:var(--vermelho,#c4122f);font:550 15px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer}.ds-btn-perigo:hover{border-color:var(--vermelho,#c4122f);background:var(--jornal,#f0efeb)}.ds-btn-perigo:focus-visible{outline:2px solid var(--tinta,#151514);outline-offset:2px}"
    },
